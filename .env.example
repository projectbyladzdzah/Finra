# ============================================================================
# FINRA ENVIRONMENT VARIABLES
# ============================================================================

# 1. WhatsApp Gateway (Fonnte)
# Dapatkan token ini dari https://fonnte.com (Dashboard -> Device -> Token)
FONNTE_TOKEN=your_fonnte_token_here

# 2. Database (Neon Postgres / Vercel Postgres)
# Bisa 1-click connect dari tab Storage di Vercel, atau dari https://neon.tech
DATABASE_URL=postgres://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 3. URL Web (Opsional)
NEXT_PUBLIC_APP_URL=https://your-finra-app.vercel.app
