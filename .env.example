# Fonnte WhatsApp Gateway API Token
# Dapatkan token ini dari https://fonnte.com (Dashboard -> Device -> Token)
FONNTE_TOKEN=your_fonnte_token_here

# Supabase PostgreSQL Database (Dapatkan di https://supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# (Opsional) URL aplikasi Anda setelah dideploy di Vercel
NEXT_PUBLIC_APP_URL=https://your-finra-app.vercel.app

